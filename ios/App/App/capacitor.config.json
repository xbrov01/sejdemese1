{
	"appId": "cz.sejdemese.app",
	"appName": "Sejdeme se",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"plugins": {
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"LocalNotifications": {
			"smallIcon": "ic_stat_notification",
			"iconColor": "#10B981"
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0f172a"
		}
	},
	"packageClassList": [
		"AppPlugin",
		"LocalNotificationsPlugin",
		"PushNotificationsPlugin",
		"StatusBarPlugin"
	]
}
